# Official API credentials: secret key remains in a local file outside Git.
ASC_ISSUER_ID=
ASC_KEY_ID=
ASC_PRIVATE_KEY_PATH=

# Optional reviewer session; generated/imported locally by the Rust CLI.
ASC_REVIEW_COOKIE_PATH=
# Set an app ID explicitly to enable reviewer update monitoring.
ASC_REVIEW_APP_ID=
# Disabled unless explicitly enabled for validation of the legacy reply route.
ASC_REVIEW_ENABLE_LEGACY_REPLY=false

# Experimental Developer Portal tools; separate interactive login is required.
ASC_DEVELOPER_APP_GROUPS_ENABLED=false
# ASC_DEVELOPER_STATE_ROOT=/private/path/Developer Portal
# ASC_DEVELOPER_COOKIE_PATH=/private/path/Developer Portal/developer-session.cookie

# Required for non-loopback Streamable HTTP listeners.
ASC_MCP_AUTH_TOKENS=

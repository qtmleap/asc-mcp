      "type": "object",
      "properties": {
        "version_id": {
          "type": "string",
          "description": "The App Store version ID"
        },
        "build_id": {
          "type": "string",
          "description": "The processed App Store eligible build ID; not the build number"
        }
      },
      "required": [
